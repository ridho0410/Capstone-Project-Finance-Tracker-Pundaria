      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json\nimport re\nfrom datetime import datetime, timezone, timedelta\n\nfrom datetime import datetime, timezone, timedelta\nitems = _items\nmessage = ((items[0].get(\"json\") or {}).get(\"message\") or {}) if items else {}\nif (message.get(\"chat\") or {}).get(\"type\") != \"private\" or isinstance(message.get(\"message_id\"), bool) or not isinstance(message.get(\"message_id\"), int) or isinstance(message.get(\"date\"), bool) or not isinstance(message.get(\"date\"), int):\n    return []\ntext = str(message.get(\"text\") or \"\").strip()\nperintah = text.startswith(\"/\")\nreceived = datetime.fromtimestamp(message[\"date\"] + 7 * 3600, timezone.utc).strftime(\"%Y-%m-%d %H:%M:%S\")\nmatch = re.fullmatch(r\"/rekap(?:@\\w+)?(?:\\s+([1-9]\\d{3}-(?:0[1-9]|1[0-2])))?\", text, re.I)\nphoto_list = message.get(\"photo\") if isinstance(message.get(\"photo\"), list) else []\nphoto = photo_list[-1] if photo_list else None\nvoice = message.get(\"voice\") or message.get(\"audio\")\nberbahaya = re.search(r\"drop\\s+table|truncate|delete\\s+from|insert\\s+into|alter\\s+table|update\\s+\\w+\\s+set|hapus\\s+(?:database|semua\\s+data|seluruh\\s+data|semua\\s+transaksi|seluruh\\s+transaksi)|reset\\s+data|kosongkan\\s+(?:database|tabel)|password|api[\\s_-]?key|token(?!\\s+(?:listrik|pln|pulsa|hp|kuota))|credential|system\\s+prompt|ignore\\s+(?:all\\s+)?previous|rm\\s+-rf|/etc/passwd|\\bsudo\\b\", text, re.I) is not None\nroute = \"Tolak\" if berbahaya else \"Bantuan\" if message.get(\"media_group_id\") else \"Rekap\" if match else \"Foto\" if isinstance(photo, dict) and photo.get(\"file_id\") else \"Suara\" if isinstance(voice, dict) and voice.get(\"file_id\") else \"Perintah\" if perintah else \"Teks\" if text else \"Bantuan\"\nbantuan = \"\\n\".join([\"Mencatat: ketik, kirim foto struk, atau kirim pesan suara.\", \"\", \"Perintah:\", \"/rekap — rekap bulan ini\", \"/saldo — saldo tiap dompet\", \"/dompet - daftar / tambah dompet\", \"/anggaran — pemakaian dan sisa anggaran\", \"/pindah 100000 BCA GoPay — pindah dana\", \"/hapus OUT-0001 — hapus transaksi tertentu\", \"/undo — batalkan transaksi terakhir\", \"/rutin — kelola transaksi rutin\", \"/ingatkan — pengingat waktu\"])\nreturn [{\"json\": {\"route\": route, \"text\": text, \"chatId\": (message.get(\"chat\") or {}).get(\"id\"), \"messageId\": message[\"message_id\"], \"received\": received, \"bulan\": match.group(1) if match and match.group(1) else received[:7], \"caption\": str(message.get(\"caption\") or \"\")[:1024], \"fileId\": (photo or {}).get(\"file_id\", \"\"), \"voiceFileId\": (voice or {}).get(\"file_id\", \"\"), \"output\": \"Silakan hanya berikan informasi terkait transaksi keuangan. Permintaan tersebut tidak dapat saya proses.\" if route == \"Tolak\" else (\"Kirim foto struk satu per satu agar tiap pembayaran tercatat sekali.\" if message.get(\"media_group_id\") else bantuan)}}]\n"
      },
