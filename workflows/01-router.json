      "parameters": {
        "jsCode": "\nconst esc = (v) => v === null || v === undefined ? 'null' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\nconst workflowName = \"Expense Tracker - Router\";\nreturn $input.all().map((item) => {\n  const m = (item && item.json) || {};\n  const p = m.result && typeof m.result === 'object' ? m.result : m;\n  const chatId = p.chat && p.chat.id ? p.chat.id : null;\n  const messageId = p.message_id === undefined ? null : p.message_id;\n  const text = p.text === undefined ? '' : p.text;\n  const executionId = $execution && $execution.id ? $execution.id : '';\n  const sql = \"insert into public.conversation_logs (chat_id, message_id, direction, kind, text, intent, workflow, execution_id) values (\" + (chatId === null ? \"null\" : chatId) + \", \" + (messageId === null ? \"null\" : messageId) + \", 'out', 'text', \" + esc(text) + \", null, \" + esc(workflowName) + \", \" + esc(executionId) + \")\";\n  return { json: { sql } };\n});\n"
