# Domain publik tanpa https://
FINANCE_HOST=your-domain.duckdns.org

# IP publik kamu (bukan IP server). Hanya IP ini yang boleh membuka editor n8n.
# Cek dengan: curl -4 -s https://api.ipify.org
# 127.0.0.1 = hanya lewat SSH tunnel; ganti dengan IP publik kamu.
FINANCE_EDITOR_IP=127.0.0.1

# Password database internal n8n (bukan Supabase).
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Kunci enkripsi n8n. Jangan diubah setelah ada credential.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-32-bytes-hex

# Token autentikasi task runner.
# Generate: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=change-me-32-bytes-hex

# Opsional, hanya kalau IP publik dinamis dan memakai updater DuckDNS.
FINANCE_DUCKDNS_SUBDOMAIN=your-subdomain
FINANCE_DUCKDNS_TOKEN=

# === Dashboard ===
# Subdomain dashboard, harus mengarah ke IP server yang sama.
DASHBOARD_HOST=dashboard.your-domain.duckdns.org

# Supabase (server-only; jangan pakai prefix NEXT_PUBLIC)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Login admin dashboard
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=change-me-32-bytes-hex
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-password-kuat

# Catatan: credential Telegram, Supabase, dan OpenAI dibuat di UI n8n,
# bukan di file .env ini.
